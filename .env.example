# ─────────────────────────────────────────────────────────────
#  Mini AI Interviewer — configuration
#  Copy this file to `.env` and fill in ONE provider below.
#  No key at all? The app still runs in demo mode.
# ─────────────────────────────────────────────────────────────

# Which provider to use: "openai" or "foundry"
LLM_PROVIDER=openai

# ── Option A: OpenAI (or any OpenAI-compatible API) ──────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Optional: point at another OpenAI-compatible provider, e.g.
# OPENAI_BASE_URL=http://localhost:11434/v1

# ── Option B: Microsoft Foundry ──────────────────────────────
# Find these under Build → Models → <your deployment> → Details
FOUNDRY_ENDPOINT=https://<your-resource>.openai.azure.com
FOUNDRY_API_KEY=
FOUNDRY_DEPLOYMENT=gpt-5.4-mini
